NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net

JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-32-chars-minimum-please
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

UPLOAD_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

ADMIN_BASE_URL=http://localhost:5173
# แจ้งเตือนลีดใหม่ผ่าน Telegram Bot — เว้นว่างได้ (ระบบจะข้ามการแจ้งเตือนเฉยๆ)
# สร้างบอทที่ @BotFather เพื่อขอ token, หา chat_id ได้จาก @userinfobot หรือ getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SEED_OWNER_EMAIL=owner@d1landandhouse.co.th
SEED_OWNER_PASSWORD=ChangeMe123!

