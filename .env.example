NODE_ENV=production
PORT=4000
API_BASE_URL=https://your-backend.onrender.com
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-backoffice.vercel.app

MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# คำเตือน: บน Render พื้นที่ไฟล์เป็นแบบ ephemeral — ไฟล์ที่อัปโหลดผ่าน UPLOAD_DIR
# จะหายทุกครั้งที่ deploy ใหม่/รีสตาร์ท ถ้าต้องการเก็บถาวรต้องย้ายไปใช้ persistent disk
# ของ Render (มีค่าใช้จ่าย) หรือ cloud storage เช่น S3/R2 แทน
UPLOAD_DIR=uploads
STORAGE_PUBLIC_URL=https://your-backend.onrender.com/uploads

ADMIN_BASE_URL=https://your-backoffice.vercel.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=D1LANDANDHOUSE <notify@yourdomain.co.th>

SEED_OWNER_EMAIL=owner@d1landandhouse.co.th
SEED_OWNER_PASSWORD=

LOG_LEVEL=info
